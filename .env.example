# Required secrets — use strong, unique values.
GVA_LR_PASSWORD= set pasword
GVA_LR_SECRET_KEY= set secrectkey


# Optional local paths. Leave blank/commented to use safe defaults.
# ROCK_VIDEO_FOLDER=~/Videos/RockVideos
# ROCK_NOTES_FOLDER=~/Documents/RockNotes
# ROCK_PROJECT_FOLDER=~/RockProject

# Optional executable overrides.
# ROCK_VLC_PATH=
# ROCK_BRAVE_PATH=

# Optional VLC remote-control settings.
# ROCK_VLC_HOST=127.0.0.1
# ROCK_VLC_PORT=4212
